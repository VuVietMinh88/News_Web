# Ten project Docker Compose
COMPOSE_PROJECT_NAME=news_web

# Cong truy cap tren localhost
NGINX_HTTP_PORT=8080
PHPMYADMIN_PORT=8081
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

# Database cua WordPress
MYSQL_DATABASE=news_db
MYSQL_USER=news_app

# Gia tri mau: phai thay trong file .env thuc te
MYSQL_PASSWORD=CHANGE_ME_APP_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
